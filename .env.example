# ---------------------------------------------------------------------------
# Trimeros Accounting Agent - example environment.
# Copy to .env and adjust. NEVER commit a real .env or real credentials.
# ---------------------------------------------------------------------------

# --- Database -------------------------------------------------------------
# "pglite" runs Postgres in-process (no Docker needed) and is the default for
# local development, tests and the smoke test.
# "postgres" talks to the Docker Compose instance (pnpm db:up).
DB_DRIVER=pglite
PGLITE_DATA_DIR=.pglite/dev
DATABASE_URL=postgres://trimeros:trimeros@localhost:5433/trimeros

# --- API ------------------------------------------------------------------
API_PORT=4000
API_HOST=127.0.0.1
LOG_LEVEL=info

# --- Web ------------------------------------------------------------------
# Base URL the Next.js review app uses to reach the API (server-side fetch).
API_BASE_URL=http://127.0.0.1:4000

# --- Safety / shadow mode -------------------------------------------------
# The system ships in strict shadow mode: it reads, analyses, proposes and
# records decisions, but sends nothing to Fortnox. Lifting it is a ladder of
# independent switches, documented in docs/shadow-mode.md and docs/autonomi.md.
SHADOW_MODE=true
# Writes need ALL of: SHADOW_MODE=false, this flag, the exact acknowledgement
# phrase below, and FORTNOX_ADAPTER other than "mock". The API refuses to
# start otherwise. Even then every voucher passes the seven-condition gate.
FORTNOX_WRITES_ENABLED=false
# FORTNOX_WRITES_ACKNOWLEDGEMENT=JAG FÖRSTÅR ATT DETTA BOKFÖR PÅ RIKTIGT I KLIENTERNAS FORTNOX
FORTNOX_ALLOW_PERIOD_LOCK=false
FORTNOX_ALLOW_CUSTOMER_EMAIL=false

# --- Fortnox integration --------------------------------------------------
# Where a client's close run reads from:
#   mock  - synthetic demo data for every client (default; tests, demos)
#   auto  - Fortnox (read-only) for clients with a live OAuth connection,
#           demo data for clients that only have the demo row
#   real  - only live connections; an unconnected client is blocked
FORTNOX_ADAPTER=mock
FORTNOX_API_BASE_URL=https://api.fortnox.se
# --- Fortnox OAuth connection ---------------------------------------------
# Credentials for the app registered in the Fortnox developer portal. They stay
# inside the API process: no response, log line or audit event contains them,
# and no language model is ever given access to them.
# Leave empty to run entirely on synthetic data - the settings page then says
# what is missing instead of offering a button that would fail.
FORTNOX_CLIENT_ID=
FORTNOX_CLIENT_SECRET=

# Seals stored Fortnox tokens (AES-256-GCM). Generate with `pnpm fortnox:keygen`.
# There is no plaintext fallback: without a valid 32-byte key the API refuses to
# start rather than storing credentials in the clear. Rotating it forces every
# client to reconnect.
FORTNOX_TOKEN_ENCRYPTION_KEY=

# The API's own public base URL. The OAuth redirect URI is derived from it as
# <API_PUBLIC_URL>/api/integrations/fortnox/callback and must match what is
# registered at Fortnox character for character.
API_PUBLIC_URL=
# Where the callback sends the browser afterwards (the review console).
WEB_BASE_URL=

# Endpoint overrides. Only needed for a sandbox, or if Fortnox moves something -
# the defaults are the documented production endpoints.
# FORTNOX_AUTHORIZE_URL=https://apps.fortnox.se/oauth-v1/auth
# FORTNOX_TOKEN_URL=https://apps.fortnox.se/oauth-v1/token
# FORTNOX_REVOKE_URL=https://apps.fortnox.se/oauth-v1/revoke

# --- Hosting (Render / Railway) -------------------------------------------
# Platforms inject PORT; the API then binds 0.0.0.0 automatically. Locally,
# leave these unset and it stays on loopback.
# PORT=

# Seeds the demo tenant when the API boots. Use on platforms with no
# pre-deploy hook. Idempotent.
SEED_ON_BOOT=false

# Password gate for a public demo URL. Empty = no gate (the local default).
# This is a shareable-link gate, NOT authentication - see docs/security-and-permissions.md.
DEMO_USER=demo
DEMO_PASSWORD=

# Comma-separated origins allowed to call the API. Empty reflects any origin,
# which is right locally and wrong in public.
WEB_ORIGIN=

# --- AI provider ----------------------------------------------------------
# "fake" is deterministic, offline and the default. "openai" is optional.
MODEL_PROVIDER=fake
MODEL_NAME=gpt-4.1-mini
MODEL_TIMEOUT_MS=30000
MODEL_MAX_RETRIES=2
OPENAI_API_KEY=
