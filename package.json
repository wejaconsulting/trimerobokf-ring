{
  "name": "trimeros-accounting-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "pnpm --filter @trimeros/db generate",
    "db:migrate": "pnpm --filter @trimeros/db migrate",
    "db:seed": "pnpm --filter @trimeros/db seed",
    "db:reset": "pnpm --filter @trimeros/db reset",
    "dev": "pnpm --parallel --filter @trimeros/api --filter @trimeros/web dev",
    "dev:api": "pnpm --filter @trimeros/api dev",
    "dev:web": "pnpm --filter @trimeros/web dev",
    "build": "pnpm --filter @trimeros/web build",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p apps/web/tsconfig.json --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "smoke": "tsx scripts/smoke.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm smoke",
    "demo:close-run": "pnpm --filter @trimeros/api close-run",
    "start:api": "pnpm --filter @trimeros/api start",
    "db:deploy": "pnpm --filter @trimeros/db migrate && pnpm --filter @trimeros/db seed"
  },
  "devDependencies": {
    "@types/node": "26.4.0",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "10.9.1",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.68.0",
    "vitest": "4.1.11",
    "@eslint/js": "10.0.1"
  }
}